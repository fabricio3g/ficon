{
  "name": "ficon",
  "version": "0.2.0",
  "description": "207 icons drawn for 16px, each with its own hover animation. Plain SVG and CSS.",
  "license": "MIT",
  "type": "module",
  "repository": "github:fabricio3g/ficon",
  "files": ["icons", "dist", "svelte"],
  "exports": {
    ".": { "svelte": "./svelte/index.ts" },
